# GEOFOX project: staff authentication and central support database.
# Add real values in Vercel, never commit them to GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY: SUPABASE_SERVICE_ROLE_KEY

# NOVANOOK project: private server-to-server access to the installed bridge RPCs.
NOVANOOK_SUPABASE_URL=
NOVANOOK_SUPABASE_SECRET_KEY=
# Legacy alternative: NOVANOOK_SUPABASE_SERVICE_ROLE_KEY

# Generate independent random secrets of at least 32 characters.
# The NovaNook app's GEOFOX_HUB_INGEST_SECRET must match the value below.
NOVANOOK_HUB_INGEST_SECRET=
HUB_RATE_LIMIT_SALT=

# Optional customer replies. Verify the sending domain before enabling delivery.
# Public contact and reply-to are fixed to the support@geofoxapps.com alias.
RESEND_API_KEY=
# Geofox Support <support@notify.geofoxapps.com> (or verified support@geofoxapps.com)
SUPPORT_FROM_EMAIL=

# Optional deployment status. Use the narrowest available Vercel token access.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=
HUB_VERCEL_PROJECT_ID=
NOVANOOK_VERCEL_PROJECT_ID=

# Extra owner-approved PUBLIC website hosts eligible for HEAD-only health checks.
# Geofox and NovaNook hosts are already allowed. Comma-separated, no URLs.
HUB_HEALTH_HOSTS=

# Turn on only after the owner's authenticator is enrolled and tested.
HUB_REQUIRE_MFA=false
# Recorded revenue is never converted across currencies.
HUB_REVENUE_CURRENCY=USD

# Never put secret/service-role keys, signing secrets, or provider tokens in
# NEXT_PUBLIC variables. They belong only in server deployment settings.

# Optional server-only text publishing. Missing/[] keeps direct publishing off.
# Exact per-company/app accounts; token setup and limitations:
# docs/social-connections.md
# Never paste real provider tokens into this file or NEXT_PUBLIC variables.
# MARKETING_SOCIAL_ACCOUNTS=[]

# Alfred: Vercel OIDC is preferred in deployed environments. Never use NEXT_PUBLIC_.
# Optional fallback for local development or a separately scoped AI Gateway key:
# AI_GATEWAY_API_KEY=
# Authenticates Vercel Cron; generate a unique random secret. Do not commit it.
# CRON_SECRET=
# Owner activation and model budgets are stored in hub_alfred_settings, initially paused.

