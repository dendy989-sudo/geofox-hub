# Optional for the initial public website. Add the Geofox project's values
# in Vercel Settings > Environment Variables when configuring authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: the real, monitored Geofox support email shown on /support.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Never put Supabase secret/service_role keys in NEXT_PUBLIC variables.
