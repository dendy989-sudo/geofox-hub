{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/alfred/cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/costs/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
